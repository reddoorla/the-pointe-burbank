    {
      "key": "s0.t1",
      "kind": "text",
      "text": "a monument ",
      "section": "s0"
    },
    {
      "key": "s0.t2",
      "kind": "text",
      "text": "of excellence",
      "section": "s0"
    },
    {
      "key": "s0.t3",
      "kind": "text",
      "text": "Nestled among the biggest names in entertainment, The Pointe  is a modern and elegant haven for the finest tenants in Burbank.",
