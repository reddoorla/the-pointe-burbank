      "key": "s7.t0",
      "kind": "text",
      "text": "a property within",
      "section": "s7"
    },
    {
      "key": "s7.t1",
      "kind": "text",
      "text": "A collection of 13 buildings offering premier office space among the biggest names in entertainment. Explore 3,100,000 SF of endless possibilities.",
      "section": "s7"
    },
    {
      "key": "s8.t0",
      "kind": "text",
      "text": "presented by",
      "section": "s8"
    },
    {
      "key": "s9.t0",
      "kind": "text",
      "text": "local amenities",
      "section": "s9"
    },
    {
      "key": "s9.t1",
      "kind": "text",
      "text": "a city full of possibilities",
      "section": "s9"
    },
    {
      "key": "s9.t2",
      "kind": "text",
      "text": "Burbank offers a wide range of opportunities from its network of world-renowned studios, accessible airport, and recreational activities.",
      "section": "s9"
    },
    {
      "key": "s9.t3",
      "kind": "text",
      "text": "Burbank Incentives",
      "section": "s9"
    },
    {
      "key": "s10.t0",
      "kind": "text",
      "text": "Be part of the community among the biggest names in entertainment. ",
      "section": "s10"
    },
    {
      "key": "s10.t1",
      "kind": "text",
      "text": "Fly, surf, ski, all within an hour away. Plus every business partner is around the corner.",
      "section": "s10"
    },
    {
      "key": "s10.t2",
      "kind": "text",
      "text": "Day or night, Burbank delights with vibrant energy and one-of-a-kind character.",
      "section": "s10"
    },
