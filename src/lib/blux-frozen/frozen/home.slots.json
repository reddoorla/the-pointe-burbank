    {
      "key": "s3.t0",
      "kind": "text",
      "text": "on-site luxuries",
      "section": "s3"
    },
    {
      "key": "s3.t1",
      "kind": "text",
      "text": "premium ",
      "section": "s3"
    },
    {
      "key": "s3.t2",
      "kind": "text",
      "text": "amenities",
      "section": "s3"
    },
    {
      "key": "s3.t3",
      "kind": "text",
      "text": "A campus built for the modern worker, The Pointe offers amenities that enrich the every day.",
      "section": "s3"
    },
    {
      "key": "s4.t0",
      "kind": "text",
      "text": "Renew and recover with exclusive access to a state-of-the-art ",
      "section": "s4"
    },
    {
      "key": "s4.t1",
      "kind": "text",
      "text": "FIT Health Club",
      "section": "s4"
    },
    {
      "key": "s4.t2",
      "kind": "text",
      "text": " with full-service locker rooms in a spa-like atmosphere. ",
      "section": "s4"
    },
    {
      "key": "s4.t3",
      "kind": "text",
      "text": "Enjoy exclusive access to on-site production and filming studios.",
      "section": "s4"
    },
    {
      "key": "s4.t4",
      "kind": "text",
      "text": "Head to the MRKT for a quick bite on-the-go, or dine in for a filling meal.",
      "section": "s4"
    },
    {
      "key": "s5.t0",
      "kind": "text",
      "text": "the outdoors",
      "section": "s5"
    },
    {
      "key": "s5.t1",
      "kind": "text",
