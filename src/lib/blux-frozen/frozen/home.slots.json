      "text": "lush haven",
      "section": "s5"
    },
    {
      "key": "s6.t0",
      "kind": "text",
      "text": "a place to sit and breathe",
      "section": "s6"
    },
    {
      "key": "s6.t1",
      "kind": "text",
      "text": "a calm escape right outside your door",
      "section": "s6"
    },
    {
      "key": "s6.t2",
