{
  "id": "catalog_page",
  "label": "Catalog Page (Blux migration)",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "",
          "single": "heading1",
          "allowTargetBlank": true
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "blux_section": {
              "type": "SharedSlice"
            },
            "blux_text": {
              "type": "SharedSlice"
            },
            "blux_block": {
              "type": "SharedSlice"
            },
            "blux_grid": {
              "type": "SharedSlice"
            },
            "blux_gallery": {
              "type": "SharedSlice"
            },
            "blux_carousel": {
              "type": "SharedSlice"
            },
            "blux_media": {
              "type": "SharedSlice"
            },
            "blux_media_text": {
              "type": "SharedSlice"
            },
            "blux_embed": {
              "type": "SharedSlice"
            },
            "blux_table": {
              "type": "SharedSlice"
            },
            "blux_collection": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
